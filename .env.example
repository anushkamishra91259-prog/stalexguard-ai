# StaleGuard AI - Environment Configuration Example

# Google Gemini API Key for deep temporal claim verification
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (default: 8000)
PORT=8000

# Optional: Gemini model override (defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Optional: Custom API Base URL for Live Backend Graph-RAG (if connected in future)
VITE_API_ENDPOINT=https://api.staleguard.ai/v1

# Optional: Analytics / Telemetry ID
VITE_ANALYTICS_ID=
